# APPLICATION — never use these development modes for production
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK_API=true
# Copy browser variables to apps/web/.env.local; API reads root .env as documented.

# DATABASE — Docker development credentials only
POSTGRES_PASSWORD=ugc_local_only
DATABASE_URL=postgresql+psycopg://ugc:ugc_local_only@127.0.0.1:55432/ugc

# REDIS
REDIS_URL=redis://127.0.0.1:56379/0

# SUPABASE / AUTH — public anon key is not the service-role key
AUTH_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Do not put a service-role key in NEXT_PUBLIC_* variables.
# Karma -> UGC service credential (server-only, >= 32 chars outside development). Empty = off.
KARMA_SERVICE_TOKEN=
# Comma-separated browser origins allowed to PUT direct uploads / GET media (e.g. the Karma app).
KARMA_ALLOWED_ORIGINS=

# R2 / S3 — configure private storage for live providers
STORAGE_MODE=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PATH=./var/assets
STORAGE_SIGNING_SECRET=development-only-signing-secret

# STRIPE — use test-mode keys for integration verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CATALOG_JSON={}

# AI PROVIDERS — no paid model enabled by default
VIDEO_PROVIDER=mock
OPENROUTER_VIDEO_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
STORYFLOW_VIDEO_DURATION_SECONDS=15
# Still look previews (virtual try-on). Separate model and flat per-image price;
# production refuses to start while this is still "mock".
IMAGE_PROVIDER=mock
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
IMAGE_CREDITS_PER_GENERATION=0
CHAT_PROVIDER=claude
# Chat authenticates with codex login (ChatGPT subscription), not an API key.
# Local signed-media-only HTTPS relay; leave empty for private S3/R2.
PROVIDER_ASSET_ORIGIN=
VIDEO_CREDITS_PER_SECOND=0
# Prompt provider configuration documented in apps/api/README.md.

# TEXT PROMPTS — deterministic development template; paid calls require opt-in
TEXT_PROVIDER=deterministic
TEXT_PROVIDER_ENABLED=false
OPENAI_API_KEY=
PROMPT_MODEL=
# MEDIA VALIDATION — external executables; use a license-reviewed build
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# DETERMINISTIC RENDER TEMPLATES — existing job worker
RENDER_ONLY_CREDITS_PER_SECOND=1
RENDER_TIMEOUT_SECONDS=600
RENDER_NODE_PATH=node
# Optional system Chrome path for local evaluation; renderer otherwise uses its browser installer
REMOTION_BROWSER_EXECUTABLE=

# Creative director uses the server-side Anthropic Messages API.
# One structured call returns CreativePlan + a single 15-second VideoPlan.
# No additional provider key is needed for this planning domain.

# Claude planning only; never video generation or browser credentials.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_ROUNDS=4
CLAUDE_MAX_WEB_SEARCHES=2
CLAUDE_MAX_WEB_FETCHES=2
CLAUDE_MAX_INPUT_TOKENS=24000
CLAUDE_MAX_OUTPUT_TOKENS=8192
CLAUDE_SESSION_BUDGET_CENTS=100
CLAUDE_VALIDATION_BUDGET_CENTS=100
CLAUDE_TIMEOUT_SECONDS=300
# Required only for Anthropic keys that are not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=
