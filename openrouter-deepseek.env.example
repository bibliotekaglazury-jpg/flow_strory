# DeepSeek through OpenRouter
# Create or copy a key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OpenAI-compatible OpenRouter endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Stable DeepSeek chat model identifier
OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=https://ugc.cerebroos.io
OPENROUTER_APP_NAME=Forma
